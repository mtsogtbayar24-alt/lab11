        "url": "{{baseUrl}}/loans/{{loanId}}/renew"
      }
    },
    {
      "name": "Return loan",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('returnedAt is present', function () { pm.expect(pm.response.json().returnedAt).to.be.a('string'); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/loans/{{loanId}}/return"
      }
    },
    {
      "name": "Unauthorized loans request",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 401', function () { pm.response.to.have.status(401); });",
              "pm.test('problem details content type', function () { pm.expect(pm.response.headers.get('Content-Type')).to.include('application/problem+json'); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/loans"
      }
    },
    {
      "name": "Reservation validation when copies exist",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('status is 422', function () { pm.response.to.have.status(422); });",
              "pm.test('problem title exists', function () { pm.expect(pm.response.json().title).to.be.a('string'); });"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"memberId\": \"{{memberId}}\",\n  \"bookId\": \"{{bookId}}\"\n}"
        },
        "url": "{{baseUrl}}/reservations"
      }
    }
  ]
